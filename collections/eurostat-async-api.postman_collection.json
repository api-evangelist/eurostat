                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/xml"
                }
              ],
              "body": "<element><?xml version=\"1.0\" encoding=\"UTF-8\"?> <S:Envelope xmlns:env=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:S=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <env:Header/>\n  <S:Body>\n    <ns0:asyncResponse xmlns:ns1=\"http://estat.ec.europa.eu/disschain/asynchronous\" xmlns:ns0=\"http://estat.ec.europa.eu/disschain/soap/asynchronous\">\n      <ns1:status>\n        <ns1:key>0f164c29-0e96-4757-9b81-e9fcff8b9899</ns1:key>\n        <ns1:status>SUBMITTED</ns1:status>\n      </ns1:status>\n    </ns0:asyncResponse>\n  </S:Body>\n</S:Envelope></element>",
              "cookie": [],
