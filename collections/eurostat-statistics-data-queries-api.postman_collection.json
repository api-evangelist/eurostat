        {
          "id": "5db4ba05-0c23-4f95-8a04-9e4af44f0cfe",
          "name": "API Statistics is a web service for data query where parameters don’t have to respect a specific order opposed to API SDMX 2.1",
          "request": {
            "name": "API Statistics is a web service for data query where parameters don’t have to respect a specific order opposed to API SDMX 2.1",
            "description": {},
            "url": {
              "path": [
                "statistics",
                "1.0",
                "data",
                ":datasetCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "JSON",
                  "description": "The format of the returned data.\n"
                },
                {
                  "disabled": false,
                  "key": "key_0",
                  "value": "<string>",
                  "description": "The filter parameters defined in the URL are optional. Any dimension present in the data product can be used as filter parameter.\nThe structure of a filter parameter follows DIMENSION_CODE=VALUE\n* DIMENSION_CODE: the code of the dimension used to filter data (case insensitive)\n* VALUE: value of the filter is the position in the dimension (case insensitive) e.g. time=2019 or geo=FR\n"
                },
                {
                  "disabled": false,
                  "key": "untilTimePeriod",
                  "value": "<string>",
                  "description": "The specific TIME_PERIOD value to filter the returned file until this value.\n"
                },
                {
                  "disabled": false,
                  "key": "sinceTimePeriod",
                  "value": "<string>",
                  "description": "The specific TIME_PERIOD value to filter the returned file since this value.\n"
                },
                {
                  "disabled": false,
                  "key": "lastTimePeriod",
                  "value": "<integer>",
                  "description": "A numeric value counting down until the TIME_PERIOD dimension values are included in the returned file.\n"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en",
                  "description": "The language of the requested data.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "datasetCode",
                  "description": "(Required) The code of the dataset to be queried.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
